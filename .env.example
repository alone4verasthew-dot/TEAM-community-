# Copy this file to .env.local and fill in your Supabase project values.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only secret used by account recovery API routes.
# Set the real value in local .env.local and Vercel server environment settings only.
# NEVER prefix this variable with NEXT_PUBLIC_ or expose it in browser code.
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
